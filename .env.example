# ==========================================
# ScholarKit Environment Variables
# ==========================================

# 1. Neon Database Connections (https://console.neon.tech)
# DATABASE_URL: Runtime pooled connection (Check "Pooled connection" checkbox in Neon dashboard)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.region.neon.tech/neondb?sslmode=require&pgbouncer=true"

# DIRECT_URL: Direct Neon connection for migrations (Uncheck "Pooled connection" checkbox in Neon dashboard)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.region.neon.tech/neondb?sslmode=require"

# SHADOW_DATABASE_URL: Local ephemeral Postgres container for Prisma shadow database
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scholarkit_shadow"

# 2. LLM Provider (OpenRouter - https://openrouter.ai)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# 3. Telegram Bot Delivery
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
